# Telegram Bot Token from @BotFather
# Replace YOUR_TELEGRAM_BOT_TOKEN_HERE with your actual bot token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Channel ID for logging actions
# This can be a numeric ID (e.g., -1001234567890) or a public channel username (e.g., @my_log_channel)
# The bot must be an administrator in this channel with permission to post messages.
# Leave empty if logging to a channel is not desired (logging will be disabled).
LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID_OR_USERNAME_HERE

# Optional: Statistics file path (defaults to 'bot_stats.json' if not set)
# STATS_FILE_PATH=bot_stats.json
